+    // gp-proxy's local SND.MAX regressions. These complement the repository's
+    // end-to-end raw-IP two-peer tests in tests/tcp_regressions.rs.
+    #[test]
+    fn test_gp_frontier_wraparound_rejects_unsent_ack() {
+        for start in [TcpSeqNumber(i32::MAX - 16), TcpSeqNumber(-16)] {
+            let mut s = socket_established();
+            s.local_seq_no = start;
+            s.remote_last_seq = start;
+            s.remote_max_seq = start;
+            s.remote_ack_seq = start;
+            s.send_slice(&[0x5a; 64]).unwrap();
+            let ack = TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(start + 64),
+                ..SEND_TEMPL
+            };
+            assert!(send(&mut s, Instant::from_millis(100), &ack).is_some());
+            assert_eq!(s.send_queue(), 64);
+            recv(&mut s, Instant::from_millis(101), |packet| {
+                assert_eq!(packet.unwrap().payload.len(), 64)
+            });
+            assert_eq!(s.remote_max_seq, start + 64);
+            send(&mut s, Instant::from_millis(102), &ack);
+            assert_eq!(s.send_queue(), 0);
+        }
+    }
+
+    #[test]
+    fn test_gp_failed_emit_does_not_authorize_ack() {
+        let mut s = socket_established();
+        let before = s.remote_max_seq;
+        s.send_slice(b"not-yet-on-the-wire").unwrap();
+        let length = s.send_queue();
+        let TestSocket { socket, cx } = &mut s;
+        assert!(socket.dispatch(cx, |_, _, _| Err::<(), ()>(())).is_err());
+        assert_eq!(s.remote_max_seq, before);
+        send(
+            &mut s,
+            Instant::from_millis(100),
+            &TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(before + length),
+                ..SEND_TEMPL
+            },
+        );
+        assert_eq!(s.send_queue(), length);
+    }
+
+    #[test]
+    fn test_gp_syn_and_fin_must_be_emitted_before_their_ack() {
+        let mut syn = socket_syn_received();
+        let response = send(
+            &mut syn,
+            Instant::from_millis(0),
+            &TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(LOCAL_SEQ + 1),
+                ..SEND_TEMPL
+            },
+        )
+        .unwrap();
+        assert_eq!(response.control, TcpControl::Rst);
+        assert_eq!(syn.state(), State::SynReceived);
+        recv(&mut syn, Instant::from_millis(1), |packet| {
+            assert_eq!(packet.unwrap().control, TcpControl::Syn)
+        });
+        send(
+            &mut syn,
+            Instant::from_millis(2),
+            &TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(LOCAL_SEQ + 1),
+                ..SEND_TEMPL
+            },
+        );
+        assert_eq!(syn.state(), State::Established);
+
+        let mut fin = socket_established();
+        fin.close();
+        let ack = TcpRepr {
+            seq_number: REMOTE_SEQ + 1,
+            ack_number: Some(LOCAL_SEQ + 2),
+            ..SEND_TEMPL
+        };
+        send(&mut fin, Instant::from_millis(0), &ack);
+        assert_eq!(fin.state(), State::FinWait1);
+        recv(&mut fin, Instant::from_millis(1), |packet| {
+            assert_eq!(packet.unwrap().control, TcpControl::Fin)
+        });
+        send(&mut fin, Instant::from_millis(2), &ack);
+        assert_eq!(fin.state(), State::FinWait2);
+    }
+
+    #[test]
+    fn test_gp_probe_advances_frontier_but_keepalive_does_not() {
+        let mut probe = socket_established();
+        let before = probe.remote_max_seq;
+        probe.send_slice(b"abcdef").unwrap();
+        send(
+            &mut probe,
+            Instant::from_millis(0),
+            &TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(before),
+                window_len: 0,
+                ..SEND_TEMPL
+            },
+        );
+        recv(&mut probe, Instant::from_millis(1000), |packet| {
+            assert_eq!(packet.unwrap().payload, b"a")
+        });
+        assert_eq!(probe.remote_max_seq, before + 1);
+        send(
+            &mut probe,
+            Instant::from_millis(1010),
+            &TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(before + 1),
+                window_len: 0,
+                ..SEND_TEMPL
+            },
+        );
+        assert_eq!(probe.send_queue(), 5);
+
+        let mut keepalive = socket_established();
+        let before = keepalive.remote_max_seq;
+        keepalive.set_keep_alive(Some(Duration::from_millis(100)));
+        recv(&mut keepalive, Instant::from_millis(0), |packet| {
+            assert_eq!(packet.unwrap().seq_number, before - 1)
+        });
+        assert_eq!(keepalive.remote_max_seq, before);
+    }
