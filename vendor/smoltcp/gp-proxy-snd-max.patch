+    #[test]
+    fn test_gp_probe_advances_frontier_but_keepalive_does_not() {
+        let mut probe = socket_established();
+        let before = probe.remote_max_seq;
+        probe.send_slice(b"abcdef").unwrap();
+        send(
+            &mut probe,
+            Instant::from_millis(0),
+            &TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(before),
+                window_len: 0,
+                ..SEND_TEMPL
+            },
+        );
+        recv(&mut probe, Instant::from_millis(1000), |packet| {
+            assert_eq!(packet.unwrap().payload, b"a")
+        });
+        assert_eq!(probe.remote_max_seq, before + 1);
+        send(
+            &mut probe,
+            Instant::from_millis(1010),
+            &TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(before + 1),
+                window_len: 0,
+                ..SEND_TEMPL
+            },
+        );
+        assert_eq!(probe.send_queue(), 5);
+
+        let mut keepalive = socket_established();
+        let before = keepalive.remote_max_seq;
+        keepalive.set_keep_alive(Some(Duration::from_millis(100)));
+        recv(&mut keepalive, Instant::from_millis(0), |packet| {
+            assert_eq!(packet.unwrap().seq_number, before - 1)
+        });
+        assert_eq!(keepalive.remote_max_seq, before);
+    }
