+    #[test]
+    fn test_gp_right_edge_exception_is_only_for_valid_pure_ack() {
+        for (control, payload, outside, unsent_ack) in [
+            (TcpControl::None, &b""[..], false, false),
+            (TcpControl::None, &b""[..], true, false),
+            (TcpControl::None, &b""[..], false, true),
+            (TcpControl::None, &b"x"[..], false, false),
+            (TcpControl::Fin, &b""[..], false, false),
+            (TcpControl::Rst, &b""[..], false, false),
+            (TcpControl::Syn, &b""[..], false, false),
+        ] {
+            let mut s = socket_established();
+            s.send_slice(b"sent").unwrap();
+            recv(&mut s, Instant::from_millis(0), |packet| {
+                assert_eq!(packet.unwrap().payload, b"sent")
+            });
+            let edge =
+                s.remote_last_ack.unwrap() + ((s.remote_last_win as usize) << s.remote_win_shift);
+            let ack = s.remote_max_seq + usize::from(unsent_ack);
+            send(
+                &mut s,
+                Instant::from_millis(100),
+                &TcpRepr {
+                    control,
+                    payload,
+                    seq_number: edge + usize::from(outside),
+                    ack_number: Some(ack),
+                    ..SEND_TEMPL
+                },
+            );
+            let valid =
+                control == TcpControl::None && payload.is_empty() && !outside && !unsent_ack;
+            assert_eq!(s.send_queue(), if valid { 0 } else { 4 });
+            assert_eq!(s.state(), State::Established);
+            assert_eq!(s.recv_queue(), 0);
+        }
+    }
