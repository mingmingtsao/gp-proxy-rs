+    #[test]
+    fn test_gp_probe_does_not_advance_ack_reply_or_dispatch_sequence() {
+        for start in [LOCAL_SEQ + 1, TcpSeqNumber(i32::MAX), TcpSeqNumber(-1)] {
+            let mut s = socket_established();
+            s.local_seq_no = start;
+            s.remote_last_seq = start;
+            s.remote_max_seq = start;
+            s.remote_ack_seq = start;
+            s.send_slice(b"abc").unwrap();
+            send(
+                &mut s,
+                Instant::from_millis(0),
+                &TcpRepr {
+                    seq_number: REMOTE_SEQ + 1,
+                    ack_number: Some(start),
+                    window_len: 0,
+                    ..SEND_TEMPL
+                },
+            );
+            recv(&mut s, Instant::from_millis(1000), |packet| {
+                let packet = packet.unwrap();
+                assert_eq!(packet.payload, b"a");
+                assert_eq!(packet.seq_number, start);
+            });
+            assert_eq!(s.remote_max_seq, start + 1);
+
+            // A rejected probe must not push either immediate or delayed ACKs
+            // beyond the peer's unchanged, zero-sized receive window.
+            let reply = send(
+                &mut s,
+                Instant::from_millis(1001),
+                &TcpRepr {
+                    seq_number: REMOTE_SEQ,
+                    ack_number: Some(start),
+                    window_len: 0,
+                    ..SEND_TEMPL
+                },
+            )
+            .unwrap();
+            assert_eq!(reply.seq_number, start);
+            send(
+                &mut s,
+                Instant::from_millis(1002),
+                &TcpRepr {
+                    seq_number: REMOTE_SEQ + 1,
+                    ack_number: Some(start),
+                    window_len: 0,
+                    payload: b"reply",
+                    ..SEND_TEMPL
+                },
+            );
+            recv(&mut s, Instant::from_millis(1020), |packet| {
+                let packet = packet.unwrap();
+                assert!(packet.payload.is_empty());
+                assert_eq!(packet.seq_number, start);
+                assert_eq!(packet.ack_number, Some(REMOTE_SEQ + 6));
+            });
+
+            // Conversely, a peer may accept the byte while still advertising
+            // zero. That legitimate ACK must release it and advance ACK SEQ.
+            send(
+                &mut s,
+                Instant::from_millis(1021),
+                &TcpRepr {
+                    seq_number: REMOTE_SEQ + 6,
+                    ack_number: Some(start + 1),
+                    window_len: 0,
+                    ..SEND_TEMPL
+                },
+            );
+            assert_eq!(s.send_queue(), 2);
+            // Respect the challenge-ACK rate limiter from the first probe.
+            let reply = send(
+                &mut s,
+                Instant::from_millis(2022),
+                &TcpRepr {
+                    seq_number: REMOTE_SEQ + 5,
+                    ack_number: Some(start + 1),
+                    window_len: 0,
+                    ..SEND_TEMPL
+                },
+            )
+            .unwrap();
+            assert_eq!(reply.seq_number, start + 1);
+        }
+    }
