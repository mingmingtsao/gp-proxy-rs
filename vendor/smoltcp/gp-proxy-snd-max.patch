+    #[test]
+    fn test_gp_pure_ack_keeps_data_retransmission_cursor() {
+        let mut s = socket_established();
+        let start = s.local_seq_no;
+        s.send_slice(b"abcdef").unwrap();
+        recv(&mut s, Instant::from_millis(0), |packet| {
+            assert_eq!(packet.unwrap().payload, b"abcdef")
+        });
+        s.remote_last_seq = start;
+        s.remote_win_len = 0;
+        s.remote_last_ack = Some(REMOTE_SEQ);
+        s.timer.set_for_idle(Instant::from_millis(1), None);
+        recv(&mut s, Instant::from_millis(1), |packet| {
+            let packet = packet.unwrap();
+            assert!(packet.payload.is_empty());
+            assert_eq!(packet.seq_number, start + 6);
+        });
+        assert_eq!(s.remote_last_seq, start);
+        s.remote_win_len = 256;
+        recv(&mut s, Instant::from_millis(2), |packet| {
+            let packet = packet.unwrap();
+            assert_eq!(packet.seq_number, start);
+            assert_eq!(packet.payload, b"abcdef");
+        });
+    }
